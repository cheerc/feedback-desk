# feedback-desk 的環境變數範本。
# 複製成 .env 再填入真正的值：cp .env.sample .env（.env 已在 .gitignore，不會被 commit）。
# CLI 不會自動讀取 .env。使用前在同一個 shell 執行：set -a; source .env; set +a

# 站點網址，例如 https://<你的站點>.workers.dev
FEEDBACK_DESK_URL=

# API token（fdk_ 開頭）。只用在 CI、雲端 session 或其他 agent。
# README：FEEDBACK_DESK_TOKEN 直接指定 token，只會送到 FEEDBACK_DESK_URL 指定的站。
# 本機已 login 時通常不需要設定。不要把真正的 token 寫進這個範本。
FEEDBACK_DESK_TOKEN=

# 標示是哪個 AI 做的。在 Claude Code、Codex 裡會自動判斷，其他環境才需要。
# FEEDBACK_DESK_AGENT=

# 專案的開發團隊頁面（不需要環境變數，CLI 用 slug 當參數）：
# <FEEDBACK_DESK_URL>/owner/<slug>/login
